{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Error",
      "System": "Error"
    }
  },
  "FileLogging": {
    "Directory": "Logs",
    "FileSizeLimitBytes": 10000000,
    "RetainedFileCountLimit": 14
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  }
}
